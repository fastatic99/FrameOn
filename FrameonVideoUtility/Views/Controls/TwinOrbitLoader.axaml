<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrameonVideoUtility.Views.Controls.TwinOrbitLoader">

    <Viewbox Stretch="Uniform">
        <Grid Width="32"
              Height="32">

            <!-- Outer orbit -->
            <Grid x:Name="OuterOrbit"
                  Width="32"
                  Height="32"
                  RenderTransformOrigin="50%,50%">

                <Ellipse Width="7"
                         Height="7"
                         Fill="#C084FC"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"/>
            </Grid>

            <!-- Inner orbit -->
            <Grid x:Name="InnerOrbit"
                  Width="22"
                  Height="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%">

                <Ellipse Width="6"
                         Height="6"
                         Fill="#94A3B8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Center dot -->
            <Ellipse Width="8"
                     Height="8"
                     Fill="#CBD5E1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

        </Grid>
    </Viewbox>
</UserControl>