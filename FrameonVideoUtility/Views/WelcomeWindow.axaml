<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FrameonVideoUtility.Views.WelcomeWindow"
        Title="Welcome to FrameOn"
        Width="520"
        Height="420"
        MinWidth="500"
        MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E293B">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#4F6F95"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6B8DB8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
        </Style>
    </Window.Styles>

    <Border Margin="20"
            Padding="20"
            Background="#243447"
            BorderBrush="#4F6F95"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="Welcome to FrameOn"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="FrameOn is ready to download and convert media."
                           Foreground="#CBD5E1"
                           FontSize="13"/>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="#3B4F6A"/>

            <TextBlock Grid.Row="2"
                       Text="FrameOn will prepare the files it needs when it starts."
                       Foreground="#E2E8F0"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock Text="Would you like FrameOn to add a desktop shortcut?"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Text="You can still launch FrameOn from the Start menu, and you can delete the shortcut later if you do not want it."
                           Foreground="#CBD5E1"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button x:Name="SkipButton"
                        AutomationProperties.AutomationId="Welcome.Skip"
                        AutomationProperties.Name="Skip shortcut creation"
                        Content="Skip" Width="90"/>
                <Button x:Name="CreateShortcutButton"
                        AutomationProperties.AutomationId="Welcome.CreateShortcut"
                        AutomationProperties.Name="Create Shortcut"
                        Content="Create Shortcut" Width="140"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
