<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FrameonVideoUtility.Views.AboutWindow"
        Title="About FrameOn"
        Width="440"
        Height="420"
        MinWidth="420"
        MinHeight="400"
        CanResize="False"
        Background="#1E293B">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#4F6F95"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6B8DB8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Background" Value="#4F6F95"/>
            <Setter Property="BorderBrush" Value="#6B8DB8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
        </Style>
    </Window.Styles>

    <Border Margin="20"
            Padding="20"
            Background="#243447"
            BorderBrush="#4F6F95"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="FrameOn Video Utility - Community Edition"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionTextBlock"
                           Text="Version"
                           Foreground="#CBD5E1"
                           FontSize="13"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Height="1"
                    Background="#3B4F6A"/>

            <TextBlock Grid.Row="2"
                       Text="A limited, sanitized source edition of FrameOn for learning, inspection, and community development."
                       Foreground="#E2E8F0"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Row="3"
                       Text="This Source Edition is licensed under the Apache License 2.0. You may use, modify, and distribute the source code subject to that license."
                       Foreground="#CBD5E1"
                       FontSize="13"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock Text="The software is provided AS IS, without warranties or conditions of any kind. Official FrameOn builds and excluded components are not licensed under Apache 2.0. Third-party tools remain subject to their respective licenses. See Licenses for details."
                           Foreground="#CBD5E1"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="CloseButton"
                    AutomationProperties.AutomationId="About.Close"
                    AutomationProperties.Name="Close About"
                    Grid.Row="5"
                    Content="Close"
                    Width="92"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
